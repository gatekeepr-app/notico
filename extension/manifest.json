{
  "manifest_version": 3,
  "name": "Notico Clipper",
  "version": "1.3",
  "description": "Quick notes into Notico",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["http://localhost:5173/*", "https://*.convex.cloud/*"],
  "action": {
    "default_title": "Notico",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
